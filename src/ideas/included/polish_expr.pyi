import ast
from token_utils import Token
import token_utils
from typing import Iterable, Generator, Any

class Parser:
    filename: str
    lasttok: None
    nexttok: Token
    tokengen: Generator[Token]

    def __init__(self, tokens: Iterable[token_utils.Token], filename: str) -> None: ...
    def advance(self) -> Token: ...
    def peekmatch(self, toktype: int, string: str | None = None) -> bool: ...
    def match(self, toktype: int, string: str | None = None) -> Token | None: ...
    def expect(self, toktype: int, string: str | None = None) -> Token: ...
    def _syntaxerror(self, msg: str, tok: Token) -> type[SyntaxError]: ...
    def file(self) -> ast.Module: ...
    def interactive(self) -> ast.Interactive: ...
    def eval(self) -> ast.expr: ...
    def stmt(self, name: str | None = None) -> ast.stmt: ...
    def expr(self) -> ast.expr: ...

def parse_source(
    src: str, filename: str, mode: str, **_kwargs: Any
) -> ast.Module | ast.Expr: ...
def add_hook(**_kwargs: Any) -> None: ...
